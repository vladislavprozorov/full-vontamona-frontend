# Переменные для docker-compose НА СЕРВЕРЕ.
# Скопировать в .env рядом с docker-compose.yml и заполнить. В git не коммитить.

# ── Доступ к базе ──────────────────────────────────────────────
# Должны совпадать с .env в репозитории cruise-database на этом же сервере
POSTGRES_DB=vontamona_cruises
POSTGRES_USER=vontamona_admin
POSTGRES_PASSWORD=

# ── Пароль на /admin (проверяет Caddy) ─────────────────────────
# Хеш получить командой:
#   docker compose run --rm caddy caddy hash-password
ADMIN_USER=mama
ADMIN_PASSWORD_HASH=
